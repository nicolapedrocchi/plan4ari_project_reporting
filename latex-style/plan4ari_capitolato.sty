\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{plan4ari_capitolato}[2026/10/02 Plan4ARI document style (Word layout of FISA_2024_00099_Allegato A)]

% All measures below are taken from Plan4ARI_v3_capittolato_definitivo.docx
% (styles.xml, numbering.xml, sectPr), so that the PDF reproduces the
% Word document. 1 twip = 1/20 pt; 720 tw = 1.27 cm.

% ---------------------------------------------------------------- page ----
% pgMar top=1843 right/bottom/left=720 header=523 footer=466 (twips).
% The footer holds the page number plus an empty paragraph (2 x 13.43 pt above
% the 0.82 cm footer distance), so Word stops the body at ~1.77 cm, not 1.27 cm.
\RequirePackage[a4paper,
  left=1.27cm,right=1.27cm,top=3.25cm,bottom=1.77cm,
  headheight=2.0cm,headsep=0.33cm,footskip=0.47cm]{geometry}

% --------------------------------------------------------------- fonts ----
\RequirePackage{fontspec}
\defaultfontfeatures{Ligatures=TeX}
\setmainfont{Calibri}
\setsansfont{Calibri}
\newfontfamily\planfootnotefont{Times New Roman}
\newfontfamily\plancourierfont{Courier New}
% Wingdings/Symbol bullets of the DOCX, via their Unicode equivalents
\newfontfamily\plansymbolfont{Segoe UI Symbol}

% Normal: Calibri 11 pt, single line spacing (Calibri: 1.2207 em)
\makeatletter
\renewcommand\normalsize{%
  \@setfontsize\normalsize{11pt}{13.43pt}%
  \abovedisplayskip 6pt \belowdisplayskip 6pt
  \abovedisplayshortskip 3pt \belowdisplayshortskip 3pt}
\renewcommand\small{\@setfontsize\small{10pt}{12.21pt}}
\renewcommand\footnotesize{\@setfontsize\footnotesize{8pt}{9.2pt}}
\makeatother
\normalsize

\RequirePackage{xcolor}
\definecolor{PlanBlue}{HTML}{4C94D8}      % ProjectName / bullets (text2 tint 80)
\definecolor{PlanBlueDark}{HTML}{0E2841}  % caption (text2)
\definecolor{PlanLink}{HTML}{0000FF}
\definecolor{PlanPale}{HTML}{DAE9F7}      % TechnicalObject shading
\definecolor{PlanGray}{HTML}{E8E8E8}      % activity rows (background2)
\definecolor{PlanRule}{HTML}{A6A6A6}      % table borders
\definecolor{PlanText}{HTML}{404040}
\definecolor{PlanGreen}{HTML}{D9EFD0}

\RequirePackage{graphicx}
\RequirePackage{array,booktabs,longtable,calc,colortbl}
\RequirePackage{etoolbox}
\RequirePackage{ragged2e}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{caption}
\RequirePackage{float}
\RequirePackage{needspace}
\RequirePackage[normalem]{ulem}
\RequirePackage{soul}
\RequirePackage[most]{tcolorbox}
\RequirePackage{xurl}
\RequirePackage[hyperfootnotes=false]{hyperref}
