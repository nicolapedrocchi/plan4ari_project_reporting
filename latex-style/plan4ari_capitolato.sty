% ------------------------------------------------------------ footnotes ----
% Footnote Text: Times New Roman 8 pt; separator: 2 in rule
\makeatletter
\renewcommand{\footnoterule}{\kern-3pt\hrule width 2in height 0.5pt\kern 2.5pt}
\renewcommand{\@makefntext}[1]{%
  \noindent\planfootnotefont\fontsize{8pt}{9.2pt}\selectfont
  \textsuperscript{\@thefnmark}\,#1}
\makeatother
\setlength{\footnotesep}{6.5pt}
\setlength{\skip\footins}{14pt plus 2pt}

% ------------------------------------------------------------- headings ----
% numbering: A / A.1 / A.1.1 / A.1.1.1 with hanging indents 432/576/720/864 tw
\renewcommand{\thesection}{\Alph{section}}
\renewcommand{\thesubsection}{\thesection.\arabic{subsection}}
\renewcommand{\thesubsubsection}{\thesubsection.\arabic{subsubsection}}
\renewcommand{\theparagraph}{\thesubsubsection.\arabic{paragraph}}
\setcounter{secnumdepth}{4}

% Heading 1: 14 pt bold, after 5 pt
\titleformat{\section}[hang]
  {\normalfont\fontsize{14pt}{17.09pt}\selectfont\bfseries}
  {\makebox[0.762cm][l]{\thesection}}{0pt}{}
% Heading 2: 11 pt bold, line 1.08, after 7.7 pt
\titleformat{\subsection}[hang]
  {\normalfont\fontsize{11pt}{14.49pt}\selectfont\bfseries}
  {\makebox[1.016cm][l]{\thesubsection}}{0pt}{}
% Heading 3: 11 pt regular, title underlined, after 7.85 pt
\titleformat{\subsubsection}[hang]
  {\normalfont\fontsize{11pt}{14.49pt}\selectfont}
  {\makebox[1.27cm][l]{\thesubsubsection}}{0pt}{\uline}
% Heading 4: 11 pt bold, after 7.7 pt
\titleformat{\paragraph}[hang]
  {\normalfont\fontsize{11pt}{14.49pt}\selectfont\bfseries}
  {\makebox[1.524cm][l]{\theparagraph}}{0pt}{}
% \parskip (4 pt) is added by TeX after each heading: subtract it
% (values calibrated against the Word PDF)
\titlespacing*{\section}{0pt}{0pt}{-1pt}
\titlespacing*{\subsection}{0pt}{0pt}{5.2pt}
\titlespacing*{\subsubsection}{0pt}{0pt}{4.85pt}
\titlespacing*{\paragraph}{0pt}{0pt}{5.2pt}
% every Heading 1 starts on a new page (explicit page breaks in the DOCX)
\newcommand{\sectionbreak}{\clearpage}

% ---------------------------------------------------------------- lists ----
% List Paragraph: left 720 tw, hanging 360 tw, contextual spacing
\newcommand{\planbulletsquare}{\textcolor{PlanBlue}{\rule[1.9pt]{3.6pt}{3.6pt}}}
\newcommand{\planbulletarrow}{\textcolor{PlanBlue}{\plansymbolfont\symbol{"21E8}}}
\newcommand{\planbulletdot}{{\plansymbolfont\symbol{"2022}}}
\newcommand{\planbulletcirc}{{\plancourierfont o}}
\setlist{topsep=0pt,partopsep=0pt,parsep=0pt,itemsep=0pt}
\setlist[itemize]{leftmargin=1.27cm,labelindent=0.635cm,labelwidth=0.635cm,
  labelsep=0pt,align=left}
\setlist[itemize,1]{label=\planbulletsquare}
\setlist[itemize,2]{label=\planbulletcirc}
\setlist[enumerate]{leftmargin=1.27cm,labelindent=0.635cm,labelwidth=0.635cm,
  labelsep=0pt,align=left}
\SetEnumitemKey{arrow}{label=\planbulletarrow}
\SetEnumitemKey{dot}{label=\planbulletdot}
\SetEnumitemKey{dash}{label=-}
% numbering "Action #%1." (accent1), left 57 tw, tab at 1021 tw
\definecolor{PlanAccent}{HTML}{156082}
\SetEnumitemKey{action}{label=\textcolor{PlanAccent}{Action \#\arabic*.},
  leftmargin=1.8cm,labelindent=0.1cm,labelwidth=1.7cm}
\SetEnumitemKey{compact}{leftmargin=0.4cm,labelindent=0pt,labelwidth=0.4cm}
\AtBeginEnvironment{itemize}{\setlength{\parskip}{0pt}}
\AtEndEnvironment{itemize}{\par}
\AtBeginEnvironment{enumerate}{\setlength{\parskip}{0pt}}
% the paragraph before a top-level list keeps its 4 pt "space after"
\setlist[itemize,1]{before=\vspace{4pt}}
\setlist[enumerate,1]{before=\vspace{4pt}}
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

% --------------------------------------------------------- inline styles ----
\newcommand{\brand}[1]{\textcolor{PlanBlue}{\textbf{#1}}}
\newcommand{\xref}[1]{\textcolor{PlanBlue}{\textbf{#1}}}

% Caption: 9 pt italic, text2 colour, centred, after 10 pt
\newcommand{\planfigurecaption}[1]{%
  \par{\centering\fontsize{9pt}{10.99pt}\selectfont\itshape\color{PlanBlueDark}#1\par}%
  \vspace{6pt}}

% TechnicalObject: shaded paragraph DAE9F7, border 4 pt left/right, 1 pt top/bottom,
% 6 pt before/after
\newcommand{\planhighlight}[1]{%
  % Word: 4 pt after the previous paragraph + 6 pt before + 1 pt padding; 6 pt after
  % (the next paragraph adds its own 4 pt \parskip)
  \par
  \begin{tcolorbox}[enhanced,breakable,sharp corners,boxrule=0pt,frame hidden,
      colback=PlanPale,left=4.5pt,right=4.5pt,top=1pt,bottom=1pt,boxsep=0pt,
      enlarge left by=-4.5pt,enlarge right by=-4.5pt,width=\linewidth+9pt,
      before skip=15pt,after skip=9pt]
    \setlength{\parskip}{4pt}#1%
  \end{tcolorbox}}

% ------------------------------------------------------- activity table ----
% "List of Activities": grid columns 1385/4974/2327/1690 tw, borders A6A6A6 1 pt,
% activity rows shaded E8E8E8, row height 593-638 tw, body cells break across pages.
\newlength{\planactcolA}\setlength{\planactcolA}{2.443cm}
\newlength{\planactcolB}\setlength{\planactcolB}{8.775cm}
\newlength{\planactcolC}\setlength{\planactcolC}{4.105cm}
\newlength{\planactcolD}
\newcommand{\planactrow}[6]{% shading, min height, #3..#6 cells
  \begingroup
  \setlength{\planactcolD}{\linewidth-\planactcolA-\planactcolB-\planactcolC}%
  \setlength{\tabcolsep}{0pt}\setlength{\arrayrulewidth}{1pt}%
  \arrayrulecolor{PlanRule}\renewcommand{\arraystretch}{1}%
  \def\planactcell##1##2{\parbox[c][#2][c]{##1}{\centering\bfseries ##2}}%
  \noindent\begin{tabular}{|*{4}{@{}c@{}|}}
  \ifx\relax#1\relax\else\rowcolor{#1}\fi
  \planactcell{\planactcolA-1pt}{#3}&\planactcell{\planactcolB-1pt}{#4}&
  \planactcell{\planactcolC-1pt}{#5}&\planactcell{\planactcolD-1.25pt}{#6}\\
  \end{tabular}\par
  \endgroup}
\newcommand{\planactivityhead}{%
  \par\vspace{4pt}\nopagebreak
  \planactrow{}{1.125cm}{ID activity}{Description}{Start month}{Duration}\nopagebreak}
\newcommand{\planactivity}[4]{%
  \par\nopagebreak\vspace{-1pt}\nopagebreak
  \planactrow{PlanGray}{1.046cm}{#1}{\color{PlanText}#2}{\color{PlanText}#3}{\color{PlanText}#4}%
  \nopagebreak}
\newtcolorbox{planactivitybody}{enhanced,breakable,sharp corners,
  colback=white,colframe=PlanRule,boxrule=1pt,arc=0pt,
  left=3.5pt,right=6.5pt,top=2.65pt,bottom=4pt,boxsep=0pt,
  before skip=0pt,after skip=0pt,before upper={\setlength{\parskip}{4pt}},
  enlarge top by=-1pt}
% blank line that precedes every task title inside an activity
\newcommand{\plantaskskip}{\par\vspace{\baselineskip}}

