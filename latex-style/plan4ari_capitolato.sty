\urlstyle{same}

% ----------------------------------------------------------- paragraphs ----
% Normal: space after 4 pt, justified, no hyphenation (as in Word)
\setlength{\parindent}{0pt}
\setlength{\parskip}{4pt}
\raggedbottom
\frenchspacing
\hyphenpenalty=10000
\exhyphenpenalty=10000
\tolerance=9999
\emergencystretch=4em
\widowpenalty=10000
\clubpenalty=10000
\setlength{\LTleft}{0pt}
\setlength{\LTright}{0pt}
\setlength{\LTpre}{4pt}
\setlength{\LTpost}{4pt}
\setlength{\tabcolsep}{4pt}
\renewcommand{\arraystretch}{1.0}
\AtBeginEnvironment{longtable}{\setlength{\parskip}{4pt}}

% figures are plain centred paragraphs in Word (no extra list spacing)
\renewenvironment{center}{\par\centering}{\par}

\makeatletter
\patchcmd\longtable{\par}{\if@noskipsec\mbox{}\fi\par}{}{}
\makeatother

\IfFileExists{footnotehyper.sty}{\RequirePackage{footnotehyper}}{\RequirePackage{footnote}}
