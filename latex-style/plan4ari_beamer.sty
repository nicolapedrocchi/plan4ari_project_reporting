\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{plan4ari_beamer}[2026/10/01 Plan4ARI Beamer style]
\RequirePackage{tikz}
\RequirePackage{graphicx}

% Assets are resolved through TEXINPUTS, alongside this shared package.
\newcommand{\planaridualasset}{plan4ari-dual-logo.png}
\IfFileExists{plan4ari-dual-logo.png}{}{%
  \renewcommand{\planaridualasset}{plan4ari-dual-logo - transparent.png}}

% --- Colour palette ---------------------------------------------------------
\definecolor{planblue}{RGB}{18,83,145}
\definecolor{plandeepblue}{RGB}{9,42,78}
\definecolor{planorange}{RGB}{222,129,38}
\definecolor{plandark}{RGB}{30,36,44}
\definecolor{planmid}{RGB}{92,105,122}
\definecolor{planlight}{RGB}{246,248,252}
\definecolor{planline}{RGB}{219,226,235}

\mode<presentation>{
  \usetheme{Madrid}
  \usecolortheme{default}
  \usefonttheme{professionalfonts}
  \setbeamertemplate{navigation symbols}{}
  \setbeamertemplate{items}[circle]
  \setbeamertemplate{sections/subsections in toc}[circle]

  \setbeamercolor{normal text}{fg=plandark,bg=white}
  \setbeamercolor{structure}{fg=planblue}
  \setbeamercolor{frametitle}{fg=white,bg=planblue}
  \setbeamercolor{title}{fg=white,bg=planblue}
  \setbeamercolor{subtitle}{fg=white}
  \setbeamercolor{author}{fg=plandark}
  \setbeamercolor{institute}{fg=planmid}
  \setbeamercolor{date}{fg=planmid}
  \setbeamercolor{block title}{fg=white,bg=planblue}
  \setbeamercolor{block body}{fg=plandark,bg=planlight}
  \setbeamercolor{alertblock title}{fg=white,bg=planorange}
  \setbeamercolor{alertblock body}{fg=plandark,bg=orange!8}
  \setbeamercolor{exampleblock title}{fg=white,bg=plandeepblue}
  \setbeamercolor{exampleblock body}{fg=plandark,bg=blue!4}
  \setbeamercolor{footline}{fg=white,bg=plandark}
  \setbeamercolor{footer logo}{fg=plandark,bg=white}
  \setbeamercolor{section in toc}{fg=planblue}

  \setbeamerfont{title}{series=\bfseries,size=\Large}
  \setbeamerfont{subtitle}{size=\normalsize}
  \setbeamerfont{frametitle}{series=\bfseries,size=\large}
  \setbeamerfont{block title}{series=\bfseries,size=\normalsize}
  \setbeamerfont{footline}{size=\scriptsize}
}

\setbeamersize{text margin left=0.62cm,text margin right=0.62cm}
\setlength{\leftmargini}{1.15em}
\setlength{\leftmarginii}{1.05em}

% --- Frame title ------------------------------------------------------------
\setbeamertemplate{frametitle}{%
  \nointerlineskip%
  \begin{beamercolorbox}[wd=\paperwidth,sep=0pt,leftskip=0.62cm,rightskip=0.62cm]{frametitle}%
    \vskip0.65ex%
    \usebeamerfont{frametitle}\strut\insertframetitle\strut\par%
    \ifx\insertframesubtitle\@empty\else%
      {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle\strut\par}%
    \fi%
    \vskip0.65ex%
  \end{beamercolorbox}%
}

% --- Footer -----------------------------------------------------------------
\setbeamertemplate{footline}{%
  \leavevmode%
  \hbox{%
    % Beamer wraps titles and sections in navigation links. Keep their
    % colour consistent with the footer instead of the global link colour.
    \hypersetup{linkcolor=white}%
    \begin{beamercolorbox}[wd=.18\paperwidth,ht=2.7ex,dp=1ex,center]{footer logo}%
      \raisebox{-0.6ex}{\includegraphics[height=2.8ex,trim=250 130 250 130,clip]{\planaridualasset}}%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.52\paperwidth,ht=2.7ex,dp=1ex,leftskip=.3cm]{footline}%
      \insertshorttitle
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.22\paperwidth,ht=2.7ex,dp=1ex,center]{footline}%
      \insertsectionhead
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.08\paperwidth,ht=2.7ex,dp=1ex,rightskip=.62cm plus1fil]{footline}%
      \insertframenumber/\inserttotalframenumber
    \end{beamercolorbox}}%
  \vskip0pt%
}

% --- Title page -------------------------------------------------------------
\setbeamertemplate{title page}{%
  \begin{tikzpicture}[remember picture,overlay]
    \fill[planblue] (current page.north west) rectangle ([yshift=-0.40\paperheight]current page.north east);
    \fill[plandeepblue] (current page.north west) rectangle ([xshift=0.022\paperwidth]current page.south west);
    \fill[planorange] ([xshift=0.022\paperwidth,yshift=-0.40\paperheight]current page.north west) rectangle ([xshift=0.032\paperwidth]current page.south west);
    % Anchor the white heading to its blue background, independently of
    % Beamer's vertical centering of the title-page contents.
    \node[anchor=west,inner sep=0pt,text width=\dimexpr\paperwidth-1.24cm\relax]
      at ([xshift=0.62cm,yshift=-0.20\paperheight]current page.north west) {%
        {\usebeamercolor[fg]{title}\usebeamerfont{title}\inserttitle\par}%
        \vspace{0.8em}%
        {\usebeamercolor[fg]{subtitle}\usebeamerfont{subtitle}\insertsubtitle\par}%
      };
    \node[anchor=east,inner sep=0pt]
      at ([xshift=-0.62cm,yshift=-0.68\paperheight]current page.north east)
      {\includegraphics[width=0.38\paperwidth]{plan4ari-wordmark-light.png}};
  \end{tikzpicture}%
  \vspace*{0.40\paperheight}
  \vfill
  {\usebeamerfont{author}\insertauthor\par}
  \vspace{0.2em}
  {\usebeamerfont{institute}\insertinstitute\par}
  \vspace{1.2em}
  {\usebeamerfont{date}\insertdate\par}
}

% --- Section divider --------------------------------------------------------
\AtBeginSection[]{%
  \begin{frame}[plain,noframenumbering]
    % Section headings contain a navigation link: its colour must also
    % be white, otherwise it disappears against the planblue background.
    \hypersetup{linkcolor=white}
    \begin{tikzpicture}[remember picture,overlay]
      \fill[planblue] (current page.north west) rectangle (current page.south east);
      \fill[planorange] (current page.south west) rectangle ([yshift=0.035\paperheight]current page.south east);
      \node[anchor=north east,inner sep=0pt]
        at ([xshift=-0.62cm,yshift=-0.45cm]current page.north east)
        {\includegraphics[width=0.25\paperwidth]{logo.png}};
    \end{tikzpicture}
    \vfill
    {\color{white}\Huge\bfseries\insertsectionhead\par}
    \vfill
  \end{frame}
}

% Compact, safe source notes. The \par avoids the Beamer error produced by a
% forced line break when the command appears at the start of vertical mode.
\newcommand{\refs}[1]{\par\vspace{0.25em}{\raggedleft\tiny\color{planmid}#1\par}}
