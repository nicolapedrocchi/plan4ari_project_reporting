\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{plan4ari}[2026/07/22 Plan4ARI document style]

\RequirePackage[a4paper,left=1.45cm,right=1.45cm,top=2.45cm,bottom=1.55cm,headheight=34pt,headsep=8pt,footskip=22pt]{geometry}
\RequirePackage{fontspec}
\defaultfontfeatures{Ligatures=TeX,Scale=MatchLowercase}
\setmainfont{Latin Modern Sans}
\setsansfont{Latin Modern Sans}
\RequirePackage{microtype}
\RequirePackage{setspace}
\setstretch{1.015}

\RequirePackage{xcolor}
\definecolor{PlanBlue}{HTML}{56A6D5}
\definecolor{PlanBlueDark}{HTML}{2D759F}
\definecolor{PlanPale}{HTML}{DDEBF7}
\definecolor{PlanGreen}{HTML}{D9EFD0}
\definecolor{PlanGray}{HTML}{D0D0D0}

\RequirePackage{graphicx}
\RequirePackage{array,booktabs,longtable,calc,colortbl}
\RequirePackage{etoolbox}
\RequirePackage{ragged2e}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{fancyhdr}
\RequirePackage{lastpage}
\RequirePackage{caption}
\RequirePackage{float}
\RequirePackage{needspace}
\RequirePackage[normalem]{ulem}
\RequirePackage{soul}
\RequirePackage{xurl}
\RequirePackage{bookmark}
\RequirePackage{hyperref}
\hypersetup{
  colorlinks=true,
  linkcolor=PlanBlueDark,
  urlcolor=PlanBlueDark,
  citecolor=PlanBlueDark,
  pdfauthor={Plan4ARI Consortium},
  pdftitle={Plan4ARI - Planning for Artificial Robotic Intelligence and Beyond},
  pdfsubject={FISA project proposal converted from DOCX to LaTeX},
  bookmarksopen=true,
  bookmarksnumbered=true
}
\urlstyle{same}

\setlength{\parindent}{0pt}
\setlength{\parskip}{3.2pt plus 1.2pt minus .7pt}
\setlength{\emergencystretch}{3em}
\setlength{\LTleft}{0pt}
\setlength{\LTright}{0pt}
\setlength{\tabcolsep}{4pt}
\renewcommand{\arraystretch}{1.05}
\AtBeginEnvironment{longtable}{\small\setlength{\parskip}{1.5pt}}

\makeatletter
\patchcmd\longtable{\par}{\if@noskipsec\mbox{}\fi\par}{}{}
\makeatother

\IfFileExists{footnotehyper.sty}{\RequirePackage{footnotehyper}}{\RequirePackage{footnote}}
\makesavenoteenv{longtable}

\makeatletter
\def\maxwidth{\ifdim\Gin@nat@width>\linewidth\linewidth\else\Gin@nat@width\fi}
\def\maxheight{\ifdim\Gin@nat@height>\textheight\textheight\else\Gin@nat@height\fi}
\makeatother
\setkeys{Gin}{width=\maxwidth,height=\maxheight,keepaspectratio}

\renewcommand{\thesection}{\Alph{section}}
\renewcommand{\thesubsection}{\thesection.\arabic{subsection}}
\renewcommand{\thesubsubsection}{\thesubsection.\arabic{subsubsection}}
\renewcommand{\theparagraph}{\thesubsubsection.\arabic{paragraph}}
\setcounter{secnumdepth}{4}
\pretocmd{\section}{\clearpage}{}{}

\titleformat{\section}[hang]{\normalfont\fontsize{13}{15}\selectfont\bfseries}{\thesection}{0.8em}{}
\titleformat{\subsection}[hang]{\normalfont\fontsize{10.5}{12.5}\selectfont\bfseries}{\thesubsection}{0.75em}{}
\titleformat{\subsubsection}[hang]{\normalfont\fontsize{10.2}{12.2}\selectfont\bfseries}{\thesubsubsection}{0.7em}{\uline}
\titleformat{\paragraph}[hang]{\normalfont\fontsize{9.8}{11.8}\selectfont\bfseries}{\theparagraph}{0.65em}{}
\titlespacing*{\section}{0pt}{1.2em}{0.45em}
\titlespacing*{\subsection}{0pt}{0.9em}{0.3em}
\titlespacing*{\subsubsection}{0pt}{0.75em}{0.22em}
\titlespacing*{\paragraph}{0pt}{0.62em}{0.18em}

\setlist[itemize,1]{label=\textcolor{PlanBlue}{\rule{3.2pt}{3.2pt}},leftmargin=2.0em,itemsep=1.5pt,topsep=2pt,parsep=0pt}
\setlist[itemize,2]{label=\textcolor{PlanBlueDark}{$\circ$},leftmargin=2.1em,itemsep=1pt,topsep=1pt,parsep=0pt}
\setlist[enumerate]{leftmargin=2.1em,itemsep=1.5pt,topsep=2pt,parsep=0pt}

\newcommand{\brand}[1]{\textcolor{PlanBlue}{\textbf{#1}}}
\newcommand{\xref}[1]{\textcolor{PlanBlue}{\textbf{#1}}}
\newcommand{\planfigurecaption}[1]{\begin{center}\vspace{-2pt}\parbox{0.94\linewidth}{\centering\small\itshape #1}\vspace{2pt}\end{center}}
\newcommand{\planhighlight}[1]{\colorbox{PlanPale}{\parbox{\dimexpr\linewidth-2\fboxsep}{#1}}}
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

\fancypagestyle{plan4ari}{%
  \fancyhf{}
  \fancyhead[L]{\includegraphics[height=0.72cm]{assets/fisa.jpg}}
  \fancyhead[R]{\includegraphics[height=0.80cm]{assets/mur.jpg}}
  \fancyfoot[R]{\footnotesize\thepage}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}
\pagestyle{plan4ari}

