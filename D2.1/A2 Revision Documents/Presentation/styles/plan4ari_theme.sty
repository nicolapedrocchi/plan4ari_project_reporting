
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{plan4ari_theme}[2026/06/19 Plan4ARI Beamer style]
\definecolor{planblue}{RGB}{16,92,160}
\definecolor{planorange}{RGB}{210,120,20}
\definecolor{plandark}{RGB}{28,36,44}
\definecolor{planlight}{RGB}{245,248,252}

\mode<presentation>{
  \usetheme{Madrid}
  \usecolortheme{default}
  \setbeamercolor{structure}{fg=planblue}
  \setbeamercolor{frametitle}{fg=white,bg=planblue}
  \setbeamercolor{title}{fg=white,bg=planblue}
  \setbeamercolor{block title}{fg=white,bg=planblue}
  \setbeamercolor{block body}{bg=planlight}
  \setbeamercolor{alertblock title}{fg=white,bg=planorange}
  \setbeamercolor{alertblock body}{bg=orange!8}
  \setbeamercolor{footline}{fg=white,bg=plandark}
  \setbeamercolor{section in toc}{fg=planblue}
  \setbeamertemplate{navigation symbols}{}
  \setbeamertemplate{items}[circle]
}

\setbeamersize{text margin left=0.55cm,text margin right=0.55cm}
\setbeamertemplate{footline}{%
\leavevmode%
\hbox{%
\begin{beamercolorbox}[wd=.76\paperwidth,ht=2.7ex,dp=1ex,leftskip=.5em]{footline}%
\insertshorttitle\hfill\insertsectionhead
\end{beamercolorbox}%
\begin{beamercolorbox}[wd=.24\paperwidth,ht=2.7ex,dp=1ex,rightskip=.5em plus1fil]{footline}%
\insertframenumber{} / \inserttotalframenumber
\end{beamercolorbox}}%
\vskip0pt%
}

\newcommand{\refs}[1]{%
  \par\vfill
  \begingroup
    \raggedright\tiny\color{gray}#1\par
  \endgroup
}
